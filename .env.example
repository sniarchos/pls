# --- pls configuration ---
# copy to .env and edit. Real environment variables override these.
# The daemon, the CLI, and the embedded client all read <install root>/.env (or $PLS_ENV_FILE).

# --- server ---
PLS_HOST=0.0.0.0
PLS_PORT=5555
PLS_CAPACITY=1
# PLS_BUDGET=42          # >0 lets (small) jobs co-reside while their summed --cost fits (e.g. GB VRAM)
PLS_HEARTBEAT_TTL=30
PLS_LABEL=shared resource
# PLS_UNIT=GB            # cost unit shown in the UI

# --- client (CLI / embedded) ---
# PLS_URL defaults to http://127.0.0.1:$PLS_PORT. Set it only for a remote/containerized broker:
# PLS_URL=http://host.docker.internal:5555
# PLS_REQUIRED=false     # true = fail closed (block) instead of running unguarded when broker is down
