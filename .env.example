# --- pls configuration ---
# copy to .env and edit. Real environment variables override these.
# The daemon, the CLI, and the embedded client all read <install root>/.env (or $PLS_ENV_FILE).
# Comments go on their own lines: text after a value is part of the value.

# --- server ---
PLS_HOST=0.0.0.0
PLS_PORT=5555
PLS_CAPACITY=1
# >0 lets (small) jobs co-reside while their summed --cost fits (e.g. GB of VRAM):
# PLS_BUDGET=42
PLS_HEARTBEAT_TTL=30
PLS_LABEL=shared resource
# cost unit shown in the UI:
# PLS_UNIT=GB
# where live tickets are saved across restarts (the systemd unit sets $STATE_DIRECTORY instead):
# PLS_STATE_FILE=/var/lib/pls/tickets.json

# --- cards (optional) ---
# Without any PLS_CARD_* lines pls guards one resource sized by PLS_CAPACITY / PLS_BUDGET.
# Each card is PLS_CARD_<n>_*; <n> is the placement order ("any" fills card 1 first).
#   _NAMES     required; comma-separated, case-insensitive; the first is the one shown
#   _DEVICE    GPU UUID (nvidia-smi -L); also works as a name, and `pls run` exports it
#   _LABEL     shown in the UI (default: the first name)
#   _TAGS      comma-separated groups, e.g. the CUDA architecture
#   _CAPACITY  default PLS_CAPACITY
#   _BUDGET    default PLS_BUDGET
# A name may belong to one card only, may not also be a tag, and "any" is reserved.
# PLS_CARD_1_NAMES=maxq,blackwell
# PLS_CARD_1_DEVICE=GPU-7c742dd2-98c6-60e3-e7a2-5f9fdaa28e52
# PLS_CARD_1_LABEL=RTX PRO 6000 Blackwell Max-Q 96 GB
# PLS_CARD_1_TAGS=sm_120
# PLS_CARD_2_NAMES=ada
# PLS_CARD_2_DEVICE=GPU-b893fc6e-1291-48a6-6789-e118daa7829b
# PLS_CARD_2_LABEL=RTX 6000 Ada 48 GB
# PLS_CARD_2_TAGS=sm_89
# Cards for tickets that name none (names and/or tags; default: any):
# PLS_DEFAULT=ada

# --- client (CLI / embedded) ---
# PLS_URL defaults to http://127.0.0.1:$PLS_PORT. Set it only for a remote/containerized broker:
# PLS_URL=http://host.docker.internal:5555
# true = fail closed (block) instead of running unguarded when the broker is down:
# PLS_REQUIRED=false
