#!/usr/bin/env python3
"""pls: a command-line client for the Polite Little Semaphore lease broker.

    pls run [--cost N] [--prio low|normal|high] [--tool L] [--user U] -- CMD...
        acquire a lease, run CMD once it's granted, release when CMD exits (or on Ctrl-C).
    pls status [--json]
        show who holds the resource and who's waiting (the terminal view).
    pls watch [--interval S]
        like `status`, refreshed in place.

Examples
    pls run --cost 24 -- docker run --gpus all boltzgen ...
    pls run --cost 12 --prio high -- /opt/bhesm/bin/bhesm-fold in.fasta -o out.cif
    pls status
"""
from __future__ import annotations

import argparse
import os
import shlex
import subprocess
import sys
import time

# import the shared client living next door (works via the /usr/local/bin symlink too,
# because realpath() resolves the link to the real bin/ dir under the install root)
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_HERE, "..", "client"))
from pls import _call, lease_sync, PLS_URL  # noqa: E402


def _fmt(secs):
    secs = int(secs or 0)
    if secs < 60:
        return f"{secs}s"
    m, s = divmod(secs, 60)
    if m < 60:
        return f"{m}m{s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m"


def _clip(text, n=36):
    text = str(text)
    return text if len(text) <= n else text[: n - 1] + "…"


def _print_status(s):
    cap = s.get("capacity", 1)
    unit = s.get("unit", "")
    budget = s.get("budget", 0)
    extra = (f"  budget {budget}{(' ' + unit) if unit else ''}") if budget else ""
    print(f"pls  {s.get('label', 'resource')}  ({PLS_URL})   capacity={cap}{extra}")
    held, waiting = s.get("held", []), s.get("waiting", [])
    if held:
        for h in held:
            cost = (f"  ~{h['cost']}{(' ' + unit) if unit else ''}") if h.get("cost") else ""
            print(f"  IN USE   {h['user']:<12} {_clip(h['tool']):<38} {_fmt(h['held_s'])}{cost}")
    else:
        print("  IN USE   (free)")
    if waiting:
        for i, w in enumerate(waiting, 1):
            print(f"  WAIT #{i:<2} {w['user']:<12} {_clip(w['tool']):<38} {w['priority']:<12} ({_fmt(w['waited_s'])})")
    else:
        print("  WAIT     (nobody)")


def cmd_status(args):
    try:
        s = _call("GET", "/status")
    except Exception as exc:
        print(f"error: broker unreachable at {PLS_URL} ({exc})", file=sys.stderr)
        return 1
    if args.json:
        import json
        print(json.dumps(s, indent=2))
    else:
        _print_status(s)
    return 0


def cmd_watch(args):
    try:
        while True:
            try:
                s = _call("GET", "/status")
                sys.stdout.write("\x1b[2J\x1b[H")  # clear screen, home cursor
                print(time.strftime("%H:%M:%S"))
                _print_status(s)
            except Exception as exc:
                sys.stdout.write("\x1b[2J\x1b[H")
                print(f"broker unreachable at {PLS_URL} ({exc})")
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0


def cmd_run(args, cmd):
    if not cmd:
        print("error: no command given (put it after `--`)", file=sys.stderr)
        return 2
    # Default label is the whole command; the web view truncates it and lets you click to
    # expand. shlex.quote keeps it copy-pasteable.
    tool = args.tool or " ".join(shlex.quote(c) for c in cmd)
    last = {"pos": None}

    def on_wait(state):
        pos = state.get("position")
        if pos and pos != last["pos"]:
            last["pos"] = pos
            sys.stderr.write(f"\r[pls] queued - position {pos} …          ")
            sys.stderr.flush()

    with lease_sync(tool=tool, cost=args.cost, priority=args.prio,
                    user=args.user, on_wait=on_wait) as tid:
        if last["pos"] is not None:
            sys.stderr.write("\r[pls] lease granted - running.            \n")
            sys.stderr.flush()
        elif tid is None:
            sys.stderr.write("[pls] running WITHOUT a lease (broker down)\n")
        return subprocess.call(cmd)


def main():
    argv = sys.argv[1:]
    cmd_after = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd_after = argv[:i], argv[i + 1:]

    p = argparse.ArgumentParser(prog="pls", description="Polite Little Semaphore (a lease broker client)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pr = sub.add_parser("run", help="acquire a lease, run CMD (after --), release")
    pr.add_argument("--cost", type=float, default=0.0, dest="cost",
                    help="estimated resource cost (e.g. GPU VRAM in GB)")
    pr.add_argument("--prio", default="normal",
                    choices=["low", "normal", "high"], help="queue priority")
    pr.add_argument("--tool", default=None, help="label shown in the queue (default: the command)")
    pr.add_argument("--user", default=None, help="override the user shown (default $USER)")

    ps = sub.add_parser("status", help="show holder + queue (one shot)")
    ps.add_argument("--json", action="store_true")

    pw = sub.add_parser("watch", help="show holder + queue, refreshed in place")
    pw.add_argument("--interval", type=float, default=2.0)

    args = p.parse_args(argv)
    if args.cmd == "run":
        return cmd_run(args, cmd_after)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "watch":
        return cmd_watch(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
