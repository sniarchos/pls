#!/usr/bin/env python3
"""pls: a command-line client for the Polite Little Semaphore lease broker.

    pls run [--on CARD] [--yes] [--cost N] [--prio low|normal|high] [--tool L] [--user U] -- CMD...
        acquire a lease, run CMD once it's granted, release when CMD exits. Ctrl-C reaches CMD
        from the terminal and SIGTERM is passed on; the lease is held until CMD exits.
        CARD is any, a card name or a tag (repeatable or comma-separated). A granted card's
        UUID replaces {device} in CMD and is exported as CUDA_VISIBLE_DEVICES and PLS_DEVICE.
        Without --on, a broker with several cards gets a question first; --yes skips it.
    pls status [--json]
        show who holds each card and who's waiting (the terminal view).
    pls watch [--interval S]
        like `status`, refreshed in place (needs a terminal).

Examples
    pls run --cost 24 -- docker run --gpus all boltzgen ...
    pls run --cost 12 --prio high -- /opt/bhesm/bin/bhesm-fold in.fasta -o out.cif
    pls run --on maxq -- docker run --gpus device={device} bindcraft2 ...
    pls status
"""
import argparse
import contextlib
import math
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time

# import the shared client living next door (works via the /usr/local/bin symlink too,
# because realpath() resolves the link to the real bin/ dir under the install root)
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_HERE, "..", "client"))
from pls import _call, lease_sync, PlsError, PLS_URL  # noqa: E402


def _fmt(secs):
    secs = int(secs or 0)
    if secs < 60:
        return f"{secs}s"
    m, s = divmod(secs, 60)
    if m < 60:
        return f"{m}m{s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m"


_ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
_CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f]")
_SECRET_FLAG = re.compile(r"token|key|secret|password", re.I)


def _clean(text):
    """Text from the broker without control characters, which a terminal would act on."""
    return _CONTROL.sub("", str(text))


def _painter(color):
    def paint(text, code):
        return f"\x1b[{code}m{text}\x1b[0m" if color else text
    return paint


def _wants_color():
    return sys.stdout.isatty() and "NO_COLOR" not in os.environ


def _visible(text):
    return len(_ANSI.sub("", text))


def _usage(cards):
    """Each card's memory and load by UUID, from nvidia-smi where it is installed."""
    if not any(str(c.get("device") or "").startswith("GPU-") for c in cards):
        return {}
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=uuid,memory.used,memory.total,utilization.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2, check=True,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return {}
    usage = {}
    for line in out.splitlines():
        try:
            uuid, used, total, load = (part.strip() for part in line.split(","))
            usage[uuid] = f"{float(used) / 1024:.1f}/{float(total) / 1024:.0f} GB  {int(load):>3}%"
        except ValueError:  # e.g. [N/A] on one card
            continue
    return usage


def _render_status(s, color=False, usage=None):
    """The status view as lines."""
    paint = _painter(color)
    unit = s.get("unit", "")
    held, waiting, cards = s.get("held", []), s.get("waiting", []), s.get("cards")
    held = [dict(h, user=_clean(h["user"]), tool=_clean(h["tool"])) for h in held]
    waiting = [dict(w, user=_clean(w["user"]), tool=_clean(w["tool"])) for w in waiting]
    if cards:
        title = f"pls · {s.get('label', 'resource')}"
        default = set(s.get("default") or []) if len(cards) > 1 else set()
        groups = [(c, [h for h in held if h.get("card") == c["id"]], c["id"] in default) for c in cards]
    else:
        title = "pls"
        one = {"label": s.get("label", "resource"), "names": [], "tags": [],
               "capacity": s.get("capacity", 1), "budget": s.get("budget", 0)}
        groups = [(one, held, False)]
    def cost(h):
        return f"  ~{h['cost']:g} {unit}".rstrip() if h.get("cost") else ""

    def eligible(w):
        return f"  for {', '.join(w.get('eligible', []))}" if cards else ""

    held_tool = max((len(h["tool"]) for h in held), default=0)
    wait_tool = max((len(w["tool"]) for w in waiting), default=0)

    heads = []
    for card, holders, is_default in groups:
        facts = [", ".join(card["names"])] if card["names"] else []
        facts += card["tags"]
        if is_default:
            facts.append("default")
        if card["capacity"] != 1:
            facts.append(f"capacity {card['capacity']}")
        if card.get("budget"):
            facts.append(f"budget {card['budget']:g} {unit}".rstrip())
        head = (paint("●", "33") if holders else paint("○", "32")) + " " + paint(card["label"], "1")
        if facts:
            head += "   " + paint(" · ".join(facts), "2")
        heads.append(head)

    lines = [paint(title, "1") + paint(f" · {PLS_URL}", "2"), ""]
    head_width = max(map(_visible, heads))
    for head, (card, holders, _) in zip(heads, groups):
        live = (usage or {}).get(card.get("device"))
        lines.append(head + " " * (head_width - _visible(head)) + "   " + live if live else head)
        if not holders:
            lines.append("    " + paint("free", "32"))
        for h in holders:
            lines.append(f"    {h['user']:<12} {h['tool']:<{held_tool}}  {_fmt(h['held_s']):>6}{cost(h)}")

    lines.append("")
    if not waiting:
        lines.append(paint("queue", "1") + "  " + paint("nobody waiting", "2"))
    else:
        lines.append(paint("queue", "1"))
        for i, w in enumerate(waiting, 1):
            lines.append(f"  {i:>2}  {w['user']:<12} {w['tool']:<{wait_tool}}  "
                         f"{w['priority']:<6}  {_fmt(w['waited_s']):>6}" + paint(eligible(w), "2"))
    return lines


def _print_status(s, usage=None):
    print("\n".join(_render_status(s, _wants_color(), usage)))


def cmd_status(args):
    try:
        s = _call("GET", "/status")
    except Exception as exc:
        print(f"error: broker unreachable at {PLS_URL} ({exc})", file=sys.stderr)
        return 1
    if args.json:
        import json
        print(json.dumps(s, indent=2))
    else:
        _print_status(s, _usage(s.get("cards") or []))
    return 0


def cmd_watch(args):
    if not sys.stdout.isatty():
        print("error: pls watch redraws a terminal; use `pls status` (or `pls status --json`) instead",
              file=sys.stderr)
        return 2
    color = _wants_color()
    paint = _painter(color)
    out = sys.stdout
    out.write("\x1b[?25l\x1b[2J")  # hide the cursor, clear once; each frame then redraws in place
    try:
        while True:
            width = shutil.get_terminal_size().columns
            try:
                s = _call("GET", "/status")
                lines = _render_status(s, color, _usage(s.get("cards") or []))
            except Exception as exc:
                lines = [paint(f"broker unreachable at {PLS_URL} ({exc})", "31")]
            stamp = paint(time.strftime("%H:%M:%S"), "2")
            lines[0] += " " * max(2, width - _visible(lines[0]) - _visible(stamp)) + stamp
            lines += ["", paint(f"refreshing every {args.interval:g}s, Ctrl-C to stop", "2")]
            out.write("\x1b[H" + "".join(line + "\x1b[K\n" for line in lines) + "\x1b[J")
            out.flush()
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0
    finally:
        out.write("\x1b[?25h")
        out.flush()


def cmd_run(args, cmd):
    if not cmd:
        print("error: no command given (put it after `--`)", file=sys.stderr)
        return 2
    tool = args.tool or _label(cmd)
    last = {"pos": None}

    def on_wait(state):
        pos = state.get("position")
        if pos and pos != last["pos"]:
            last["pos"] = pos
            sys.stderr.write(f"\r[pls] queued - position {pos} ...        ")
            sys.stderr.flush()

    _catch(_exit_on, signal.SIGTERM, signal.SIGHUP)
    try:
        if not args.on and not args.yes:
            stop = _confirm_default()
            if stop is not None:
                return stop
        with lease_sync(tool=tool, cost=args.cost, priority=args.prio, user=args.user,
                        on_wait=on_wait, on=args.on) as grant:
            return _launch(cmd, grant, waited=last["pos"] is not None)
    except PlsError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    except (KeyboardInterrupt, SystemExit) as exc:
        sys.stderr.write("\n[pls] Not started.\n")
        return exc.code if isinstance(exc, SystemExit) else 130


def _catch(handler, *signals):
    """Handle each of ``signals`` unless pls was started with it ignored (nohup, trap ''), so the
    command inherits that ignore too."""
    for signum in signals:
        if signal.getsignal(signum) != signal.SIG_IGN:
            signal.signal(signum, handler)


def _exit_on(signum, _frame):
    raise SystemExit(128 + signum)  # leaves the queue through lease_sync's release


def _foreground():
    """Whether pls is in its terminal's foreground group, which a Ctrl-C reaches as a whole."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY | os.O_NOCTTY)
    except OSError:
        return False
    try:
        return os.tcgetpgrp(fd) == os.getpgrp()
    except OSError:
        return False
    finally:
        os.close(fd)


def _label(cmd):
    """The command as the queue shows it, with the values of -e/--env pairs, and of flags whose
    name says token, key, secret or password, shown as ***."""
    words, hide = [], None
    for arg in cmd:
        if hide and not arg.startswith("-"):
            words.append(hide(arg))
            hide = None
            continue
        flag, eq, value = arg.partition("=")
        hide = None
        if flag in ("-e", "--env"):
            hide = _hide_pair
        elif flag.startswith("-") and _SECRET_FLAG.search(flag):
            hide = _hide_value
        if hide and eq:
            words.append(shlex.quote(flag + eq) + hide(value))
            hide = None
        else:
            words.append(shlex.quote(arg))
    return " ".join(words)


def _hide_pair(pair):
    name, eq, _ = pair.partition("=")
    return shlex.quote(name + eq) + "***" if eq else shlex.quote(pair)


def _hide_value(_value):
    return "***"


def _confirm_default():
    """Explain where a job without --on goes and ask. None means go ahead, else an exit code."""
    try:
        s = _call("GET", "/status")
    except Exception:
        return None  # broker down: lease_sync fails open and says so
    cards = s.get("cards") or []
    if len(cards) < 2:
        return None
    default = s.get("default") or [c["id"] for c in cards]
    held, waiting = s.get("held", []), s.get("waiting", [])
    lines = ["No --on given, so this job would queue for the default "
             + ("card:" if len(default) == 1 else "cards, whichever frees first:")]
    for c in cards:
        if c["id"] not in default:
            continue
        users = [f"{_clean(h['user'])} ({_clean(h['tool'])})" for h in held if h.get("card") == c["id"]]
        queued = sum(1 for w in waiting if c["id"] in w.get("eligible", []))
        lines.append(f"  {c['label']} [{', '.join(c['names'])}]: "
                     f"{'held by ' + ', '.join(users) if users else 'free'}, {queued} waiting")
    picks = sorted({t for c in cards for t in c["tags"]})
    lines.append("To pick, pass --on any, a name ("
                 + ", ".join(n for c in cards for n in c["names"]) + ")"
                 + (f" or a tag ({', '.join(picks)})" if picks else "") + ".")
    sys.stderr.write("".join(f"[pls] {line}\n" for line in lines))
    if sys.stdin is None or not sys.stdin.isatty():
        sys.stderr.write("[pls] Nobody can answer here: pass --on, or --yes for the default. Not started.\n")
        return 2
    sys.stderr.write("[pls] Queue for the default? [y/N] ")
    sys.stderr.flush()
    if sys.stdin.readline().strip().lower() in ("y", "yes"):
        return None
    sys.stderr.write("[pls] Not started.\n")
    return 1


def _launch(cmd, grant, waited):
    if grant is None:
        msg = "running WITHOUT a lease (broker down)"
    elif grant.card:
        about = f" ({grant.label})" if grant.label != grant.card else ""
        msg = f"lease granted on {grant.card}{about} - running."
    else:
        msg = "lease granted - running." if waited else ""
    if msg:
        lead = "\r" if waited else ""
        sys.stderr.write(f"{lead}[pls] {msg}            \n")
        sys.stderr.flush()

    device = grant.device if grant else None
    if any("{device}" in c for c in cmd):
        if not device:
            print("error: the command uses {device} but no card was granted", file=sys.stderr)
            return 2
        cmd = [c.replace("{device}", device) for c in cmd]
    env = None
    if grant and grant.card:
        env = dict(os.environ, PLS_CARD=grant.card)
        if device:
            env.update(CUDA_VISIBLE_DEVICES=device, CUDA_DEVICE_ORDER="PCI_BUS_ID", PLS_DEVICE=device)
    return _run(cmd, env)


def _run(cmd, env):
    """Run CMD and wait for it to exit, however pls is asked to stop, so the lease outlives it.
    SIGTERM is passed on, and so is a SIGINT that did not come from the terminal, where Ctrl-C
    reaches CMD directly. A hangup reaches CMD directly too. Returns CMD's exit code, 128+N when
    signal N ended it."""
    child, early = [], []

    def forward(signum, _frame):
        if not child:
            early.append(signum)
        elif signum == signal.SIGTERM or (signum == signal.SIGINT and not _foreground()):
            with contextlib.suppress(ProcessLookupError):
                child[0].send_signal(signum)

    # Left in place after CMD exits, so the release that follows cannot be interrupted either.
    _catch(forward, signal.SIGINT, signal.SIGTERM, signal.SIGHUP)
    child.append(subprocess.Popen(cmd, env=env))
    for signum in early:
        child[0].send_signal(signum)
    code = child[0].wait()
    return code if code >= 0 else 128 - code


def _cost(text):
    try:
        value = float(text)
    except ValueError:
        value = math.nan
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"{text!r} is not a finite number >= 0")
    return value


def main():
    argv = sys.argv[1:]
    cmd_after = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd_after = argv[:i], argv[i + 1:]

    p = argparse.ArgumentParser(prog="pls", description="Polite Little Semaphore (a lease broker client)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pr = sub.add_parser("run", help="acquire a lease, run CMD (after --), release")
    pr.add_argument("--on", action="append", default=None, metavar="CARD",
                    help="any, a card name or a tag; repeatable or comma-separated "
                         "(default: the broker's PLS_DEFAULT, after asking)")
    pr.add_argument("-y", "--yes", action="store_true",
                    help="take the default cards without asking")
    pr.add_argument("--cost", type=_cost, default=0.0, dest="cost",
                    help="estimated resource cost (e.g. GPU VRAM in GB), a number >= 0")
    pr.add_argument("--prio", default="normal",
                    choices=["low", "normal", "high"], help="queue priority")
    pr.add_argument("--tool", default=None, help="label shown in the queue (default: the command)")
    pr.add_argument("--user", default=None, help="override the user shown (default $USER)")

    ps = sub.add_parser("status", help="show holders + queue (one shot)")
    ps.add_argument("--json", action="store_true")

    pw = sub.add_parser("watch", help="show holders + queue, refreshed in place")
    pw.add_argument("--interval", type=float, default=2.0)

    args = p.parse_args(argv)
    if args.cmd == "watch" and not 0 < args.interval < math.inf:
        pw.error("--interval must be a number of seconds > 0")
    if args.cmd == "run":
        return cmd_run(args, cmd_after)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "watch":
        return cmd_watch(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
