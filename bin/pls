#!/usr/bin/env python3
"""pls: a command-line client for the Polite Little Semaphore lease broker.

    pls run [--on CARD] [--cost N] [--prio low|normal|high] [--tool L] [--user U] -- CMD...
        acquire a lease, run CMD once it's granted, release when CMD exits (or on Ctrl-C).
        CARD is any, a card name or a tag (repeatable or comma-separated). A granted card's
        UUID replaces {device} in CMD and is exported as CUDA_VISIBLE_DEVICES and PLS_DEVICE.
    pls status [--json]
        show who holds each card and who's waiting (the terminal view).
    pls watch [--interval S]
        like `status`, refreshed in place.

Examples
    pls run --cost 24 -- docker run --gpus all boltzgen ...
    pls run --cost 12 --prio high -- /opt/bhesm/bin/bhesm-fold in.fasta -o out.cif
    pls run --on maxq -- docker run --gpus device={device} bindcraft2 ...
    pls status
"""
import argparse
import os
import shlex
import subprocess
import sys
import time

# import the shared client living next door (works via the /usr/local/bin symlink too,
# because realpath() resolves the link to the real bin/ dir under the install root)
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(_HERE, "..", "client"))
from pls import _call, lease_sync, PlsError, PLS_URL  # noqa: E402


def _fmt(secs):
    secs = int(secs or 0)
    if secs < 60:
        return f"{secs}s"
    m, s = divmod(secs, 60)
    if m < 60:
        return f"{m}m{s:02d}s"
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m"


def _print_status(s):
    unit = s.get("unit", "")
    u = (" " + unit) if unit else ""
    held, waiting, cards = s.get("held", []), s.get("waiting", []), s.get("cards")
    if cards:
        print(f"pls  {s.get('label', 'resource')}  ({PLS_URL})")
        for c in cards:
            tags = f" tags={','.join(c['tags'])}" if c["tags"] else ""
            budget = f"  budget {c['budget']}{u}" if c.get("budget") else ""
            print(f"  {c['label']}  names={','.join(c['names'])}{tags}  capacity={c['capacity']}{budget}")
            _print_held([h for h in held if h.get("card") == c["id"]], u, "    ")
    else:
        budget = s.get("budget", 0)
        extra = f"  budget {budget}{u}" if budget else ""
        print(f"pls  {s.get('label', 'resource')}  ({PLS_URL})   capacity={s.get('capacity', 1)}{extra}")
        _print_held(held, u, "  ")
    if waiting:
        for i, w in enumerate(waiting, 1):
            line = f"  WAIT #{i:<2} {w['user']:<12} {w['tool']:<38} {w['priority']:<12} ({_fmt(w['waited_s'])})"
            if cards:
                line += f"  for {', '.join(w.get('eligible', []))}"
            print(line)
    else:
        print("  WAIT     (nobody)")


def _print_held(held, u, pad):
    if not held:
        print(f"{pad}IN USE   (free)")
    for h in held:
        cost = f"  ~{h['cost']}{u}" if h.get("cost") else ""
        print(f"{pad}IN USE   {h['user']:<12} {h['tool']:<38} {_fmt(h['held_s'])}{cost}")


def cmd_status(args):
    try:
        s = _call("GET", "/status")
    except Exception as exc:
        print(f"error: broker unreachable at {PLS_URL} ({exc})", file=sys.stderr)
        return 1
    if args.json:
        import json
        print(json.dumps(s, indent=2))
    else:
        _print_status(s)
    return 0


def cmd_watch(args):
    try:
        while True:
            try:
                s = _call("GET", "/status")
                sys.stdout.write("\x1b[2J\x1b[H")  # clear screen, home cursor
                print(time.strftime("%H:%M:%S"))
                _print_status(s)
            except Exception as exc:
                sys.stdout.write("\x1b[2J\x1b[H")
                print(f"broker unreachable at {PLS_URL} ({exc})")
            time.sleep(args.interval)
    except KeyboardInterrupt:
        return 0


def cmd_run(args, cmd):
    if not cmd:
        print("error: no command given (put it after `--`)", file=sys.stderr)
        return 2
    tool = args.tool or " ".join(shlex.quote(c) for c in cmd)
    last = {"pos": None}

    def on_wait(state):
        pos = state.get("position")
        if pos and pos != last["pos"]:
            last["pos"] = pos
            sys.stderr.write(f"\r[pls] queued - position {pos} ...        ")
            sys.stderr.flush()

    try:
        with lease_sync(tool=tool, cost=args.cost, priority=args.prio, user=args.user,
                        on_wait=on_wait, on=args.on) as grant:
            return _launch(cmd, grant, waited=last["pos"] is not None)
    except PlsError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


def _launch(cmd, grant, waited):
    if grant is None:
        msg = "running WITHOUT a lease (broker down)"
    elif grant.card:
        about = f" ({grant.label})" if grant.label != grant.card else ""
        msg = f"lease granted on {grant.card}{about} - running."
    else:
        msg = "lease granted - running." if waited else ""
    if msg:
        lead = "\r" if waited else ""
        sys.stderr.write(f"{lead}[pls] {msg}            \n")
        sys.stderr.flush()

    device = grant.device if grant else None
    if any("{device}" in c for c in cmd):
        if not device:
            print("error: the command uses {device} but no card was granted", file=sys.stderr)
            return 2
        cmd = [c.replace("{device}", device) for c in cmd]
    env = None
    if grant and grant.card:
        env = dict(os.environ, PLS_CARD=grant.card)
        if device:
            env.update(CUDA_VISIBLE_DEVICES=device, CUDA_DEVICE_ORDER="PCI_BUS_ID", PLS_DEVICE=device)
    return subprocess.call(cmd, env=env)


def main():
    argv = sys.argv[1:]
    cmd_after = []
    if "--" in argv:
        i = argv.index("--")
        argv, cmd_after = argv[:i], argv[i + 1:]

    p = argparse.ArgumentParser(prog="pls", description="Polite Little Semaphore (a lease broker client)")
    sub = p.add_subparsers(dest="cmd", required=True)

    pr = sub.add_parser("run", help="acquire a lease, run CMD (after --), release")
    pr.add_argument("--on", action="append", default=None, metavar="CARD",
                    help="any, a card name or a tag; repeatable or comma-separated "
                         "(default: the broker's PLS_DEFAULT)")
    pr.add_argument("--cost", type=float, default=0.0, dest="cost",
                    help="estimated resource cost (e.g. GPU VRAM in GB)")
    pr.add_argument("--prio", default="normal",
                    choices=["low", "normal", "high"], help="queue priority")
    pr.add_argument("--tool", default=None, help="label shown in the queue (default: the command)")
    pr.add_argument("--user", default=None, help="override the user shown (default $USER)")

    ps = sub.add_parser("status", help="show holders + queue (one shot)")
    ps.add_argument("--json", action="store_true")

    pw = sub.add_parser("watch", help="show holders + queue, refreshed in place")
    pw.add_argument("--interval", type=float, default=2.0)

    args = p.parse_args(argv)
    if args.cmd == "run":
        return cmd_run(args, cmd_after)
    if args.cmd == "status":
        return cmd_status(args)
    if args.cmd == "watch":
        return cmd_watch(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
